# GharOS — environment variables (backend)
# Copy to backend/.env for local dev. Never commit a filled-in .env.

# GCP project
GCP_PROJECT_ID=
GCP_REGION=asia-south1

# Firestore
FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_DATABASE=(default)

# Pub/Sub
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_TOPIC_PREFIX=gharos-

# Vertex AI / Gemini
VERTEX_AI_LOCATION=asia-south1
GEMINI_MODEL_FLASH=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-pro-latest

# App
ENV=local
LOG_LEVEL=INFO
BUDGET_ALERT_THRESHOLD_USD=25
