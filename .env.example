# GharOS — environment variables (backend)
# Copy to backend/.env for local dev. Never commit a filled-in .env.

# GCP project
GCP_PROJECT_ID=
GCP_REGION=asia-south1

# Firestore
FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_DATABASE=(default)

# Pub/Sub
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_TOPIC_PREFIX=gharos-

# Pub/Sub push verification (app.api.pubsub_receiver) — set by
# infra/pubsub_topics.sh after the push subscription is wired to a real
# deployed service URL. Empty = verification skipped, local/emulator dev
# only. See backend/app/settings.py for the full explanation.
PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=
PUBSUB_PUSH_AUDIENCE=

# Vertex AI / Gemini
# Pinned publisher-model versions (not "-latest" aliases — those 404 on
# Vertex AI's regional endpoint; see backend/app/settings.py for the full
# explanation, live-tested in Phase 2).
VERTEX_AI_LOCATION=asia-south1
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
# Pro-tier resolves through a separate location — gemini-2.5-pro 404s
# regionally for this project (see backend/app/settings.py, ADR-010).
VERTEX_AI_LOCATION_PRO=global

# CORS — comma-separated exact origins allowed to call this API
# cross-origin (e.g. the deployed gharos-web /status page). Empty = no
# CORSMiddleware installed at all (local dev default). Never a wildcard —
# see backend/app/settings.py. Set by infra/deploy_backend.sh once
# gharos-web's real deployed URL is known.
CORS_ALLOWED_ORIGINS=

# Raw payload storage (app.persistence.raw_payload_store) — backs
# SOURCE_DOCUMENT.raw_payload_ref. Local-filesystem-backed for now
# (see raw_payload_store.py for the GCS swap-point rationale). Relative
# paths resolve against the process's working directory.
RAW_PAYLOAD_STORAGE_DIR=./data/raw_payloads

# App
ENV=local
LOG_LEVEL=INFO
BUDGET_ALERT_THRESHOLD_USD=25
